# Copy to .env and fill in your REMARKETS credentials. Never commit .env.
PRIMARY_USER=your_remarkets_username
PRIMARY_PASSWORD=your_remarkets_password
# Required only by the separately opted-in demo execution harness.
PRIMARY_ACCOUNT=your_remarkets_account

# Separate PPI production credentials (Gestiones > Gestion de servicio API).
# Do not reuse Primary credentials. No network without explicit --live.
PPI_API_KEY=
PPI_API_SECRET=
PPI_AUTHORIZED_CLIENT=
PPI_CLIENT_KEY=
