# Copy to .env and fill in your GGAL Desk credentials. Never commit .env.
PRIMARY_USER=your_remarkets_username
PRIMARY_PASSWORD=your_remarkets_password

# Separate PPI production credentials (Gestiones > Gestion de servicio API).
# Do not reuse Primary credentials. Start live reads explicitly in the app or CLI.
PPI_API_KEY=
PPI_API_SECRET=
PPI_AUTHORIZED_CLIENT=
PPI_CLIENT_KEY=
